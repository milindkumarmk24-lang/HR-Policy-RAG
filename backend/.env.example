# Copy this file to backend/.env and fill in your key. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# Generation model, and the model RAGAS uses as judge (defaults to GEMINI_MODEL).
# Run `python scripts/list_models.py` to see what your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=gemini-3.5-flash-lite

# One shared rate limit for every Gemini call (answers, routing, RAGAS judge).
# Free-tier keys allow about 15 requests/minute; raise this on a paid key.
GEMINI_RPM=14

# Local models (downloaded from Hugging Face on first run, then cached)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
FETCH_K=12
TOP_N=4
TOP_N_PER_SUBQUESTION=3
MAX_CONTEXT_CHUNKS=8

# Per-query RAGAS scoring in the background (needs the API key)
EVAL_ENABLED=true

# Index the bundled sample handbook on first start
AUTOLOAD_SAMPLE=true

# Origins allowed to call the API from a browser (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
